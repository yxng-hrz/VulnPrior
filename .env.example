APP_NAME=VulnPrior
ENVIRONMENT=development
DATABASE_URL=sqlite:///./vulnprior.db
CORS_ORIGINS=*
RISK_CRITICAL_THRESHOLD=80
RISK_HIGH_THRESHOLD=60
RISK_MEDIUM_THRESHOLD=35
# v2 — security (empty = demo mode)
API_KEYS=
# v2 — risk acceptance guardrails
ACCEPTANCE_MAX_DAYS=180
KEV_ACCEPTANCE_MAX_DAYS=30
# v2 — scoring weights (defaults shown)
WEIGHT_KEV=18
WEIGHT_RANSOMWARE=6
WEIGHT_CONTROL=-12
# v2 — threat-intelligence feeds
EPSS_API_URL=https://api.first.org/data/v1/epss
KEV_FEED_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
